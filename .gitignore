# =============================================================================
#  Qué NO se sube al repositorio
# =============================================================================

# PlatformIO: carpeta de compilación. Pesa decenas de megas, es distinta en
# cada ordenador y se regenera sola. Nunca se versiona.
.pio/

# VS Code: solo se versiona la lista de extensiones recomendadas. El resto
# (c_cpp_properties.json, launch.json) lo genera PlatformIO con rutas
# absolutas de TU máquina, así que a otro no le sirve.
**/.vscode/*
!**/.vscode/extensions.json

# Wokwi: la licencia de la extensión es personal e intransferible.
.wokwi/
wokwi-license.txt

# Basura de los sistemas operativos
Thumbs.db
desktop.ini
.DS_Store

# NOTA: include/HardwareConfig.h SÍ se versiona a propósito, aunque lo genere
# el script. Así el repositorio compila también en un equipo sin Python, y el
# CI puede avisarte si se ha quedado desfasado respecto al diagram.json.
